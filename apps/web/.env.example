# apps/web/.env.example
# VARIABLE NAMES ONLY. NEVER PUT REAL VALUES HERE; SET THEM IN THE HOSTING PROVIDER'S ENVIRONMENT SETTINGS.
# ALL AUTH CALLS RUN ON THE SERVER, SO NONE OF THESE ARE EXPOSED TO THE BROWSER (NO NEXT_PUBLIC_ PREFIX).
# SUPABASE PROJECT URL, E.G. https://<project-ref>.supabase.co
SUPABASE_URL=
# SUPABASE PUBLISHABLE KEY (sb_publishable_...). PUBLIC BY DESIGN, BUT KEPT SERVER-SIDE HERE.
SUPABASE_PUBLISHABLE_KEY=
# EXPLORAAI API BASE URL, E.G. http://127.0.0.1:8000 LOCALLY.
EXPLORAAI_API_URL=
