# apps/web/.env.example
# VARIABLE NAMES ONLY. NEVER PUT REAL VALUES HERE; SET THEM IN THE HOSTING PROVIDER'S ENVIRONMENT SETTINGS.
# NEXT_PUBLIC_* VALUES ARE VISIBLE IN THE BROWSER: ONLY PUBLIC (PUBLISHABLE) KEYS MAY USE THAT PREFIX.
# NONE ARE USED YET IN THE SKELETON. THEY ARE WIRED IN FROM M1.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_BASE_URL=
