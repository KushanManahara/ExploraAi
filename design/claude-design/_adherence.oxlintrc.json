{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/chat/**",
              "components/content/**",
              "components/core/**",
              "components/navigation/**",
              "ui_kits/portfolio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Familjen Grotesk|Spline Sans Mono))/i]",
        "message": "Font not provided by the design system. Available: Familjen Grotesk, Spline Sans Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowOrb'] > JSXAttribute > JSXIdentifier[name!=/^(?:glyph|size|tone|style|key|ref|className|style|children)$/]",
        "message": "<ArrowOrb> doesn't accept that prop. Declared props: glyph, size, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowOrb'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|accent|paper)$/]",
        "message": "<ArrowOrb> tone must be one of 'ink' | 'accent' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|href|variant|size|style|key|ref|className|style|children)$/]",
        "message": "<BrandMark> doesn't accept that prop. Declared props: name, href, variant, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:wordmark|monogram)$/]",
        "message": "<BrandMark> variant must be one of 'wordmark' | 'monogram'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|arrow|orb|count|href|onClick|disabled|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, arrow, orb, count, href, onClick, disabled, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ink|accent|soft|outline|light|link)$/]",
        "message": "<Button> variant must be one of 'ink' | 'accent' | 'soft' | 'outline' | 'light' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|text|key|ref|className|style|children)$/]",
        "message": "<ChatMessage> doesn't accept that prop. Declared props: role, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatMessage'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:user|bot)$/]",
        "message": "<ChatMessage> role must be one of 'user' | 'bot'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExpertiseCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|mono|title|desc|tags|used|active|minHeight|style|key|ref|className|style|children)$/]",
        "message": "<ExpertiseCard> doesn't accept that prop. Declared props: n, mono, title, desc, tags, used, active, minHeight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|rule|tone|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, rule, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|accent)$/]",
        "message": "<Eyebrow> tone must be one of 'default' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FactList'] > JSXAttribute > JSXIdentifier[name!=/^(?:rows|variant|dark|style|key|ref|className|style|children)$/]",
        "message": "<FactList> doesn't accept that prop. Declared props: rows, variant, dark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FactList'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:facts|meta)$/]",
        "message": "<FactList> variant must be one of 'facts' | 'meta'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|links|active|onNavigate|clock|cta|onCta|position|hideOnScroll|backdrop|adaptive|theme|defaultTheme|scrollTarget|style|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: name, links, active, onNavigate, clock, cta, onCta, position, hideOnScroll, backdrop, adaptive, theme, defaultTheme, scrollTarget, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:static|fixed|sticky)$/]",
        "message": "<NavBar> position must be one of 'static' | 'fixed' | 'sticky'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<NavBar> theme must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute[name.name='defaultTheme'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<NavBar> defaultTheme must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:img|n|title|year|metric|metricLabel|onClick|width|height|style|key|ref|className|style|children)$/]",
        "message": "<ProjectCard> doesn't accept that prop. Declared props: img, n, title, year, metric, metricLabel, onClick, width, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|title|client|desc|year|kind|featured|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ProjectRow> doesn't accept that prop. Declared props: n, title, client, desc, year, kind, featured, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:company|quote|who|role|avatar|tone|style|key|ref|className|style|children)$/]",
        "message": "<QuoteCard> doesn't accept that prop. Declared props: company, quote, who, role, avatar, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:white|ink|accent)$/]",
        "message": "<QuoteCard> tone must be one of 'white' | 'ink' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|lead|size|as|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, lead, size, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:display|h1|h2|h3)$/]",
        "message": "<SectionHeading> size must be one of 'display' | 'h1' | 'h2' | 'h3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedLens'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SegmentedLens> doesn't accept that prop. Declared props: items, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|variant|style|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, label, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:sans|compact)$/]",
        "message": "<Stat> variant must be one of 'sans' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<StatusDot> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|signal|warning)$/]",
        "message": "<StatusDot> tone must be one of 'success' | 'signal' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|lamp|children|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: variant, lamp, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:mono|accent|glass|outline|chip)$/]",
        "message": "<Tag> variant must be one of 'mono' | 'accent' | 'glass' | 'outline' | 'chip'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:abbr|name|note|bg|style|key|ref|className|style|children)$/]",
        "message": "<ToolTile> doesn't accept that prop. Declared props: abbr, name, note, bg, style."
      }
    ]
  },
